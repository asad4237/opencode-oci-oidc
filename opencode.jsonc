{
  "$schema": "https://opencode.ai/config.json",

  // Plugin list
  "plugin": ["/home/ubuntu/plt-p-llm-proxy/oci-opencode-auth/dist/index.js"],

  // Provider configuration for OpenAI-compatible endpoint
  "provider": {
    "oci-oidc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCI OIDC Auth",
      "options": {
        "baseURL": "https://10.238.113.14/api"
      },
      "models": {
        "tawn-gpt-oss-120b": {
          "id": "tawn-gpt-oss-120b",
          "name": "tawn-gpt-oss-120b",
          "limit": { "context": 131072, "output": 65536 }
        }
      }
    }
  },
  // Set default model
  "model": "oci-oidc/tawn-gpt-oss-120b"
}
