{
  "name": "opencode-oci-oidc",
  "version": "1.0.0",
  "description": "OpenCode plugin: OCI OIDC Auth — authenticates with an OCI Confidential Application and injects Bearer tokens into an OpenAI-compatible LLM endpoint.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "oci",
    "oidc",
    "oracle-cloud",
    "llm",
    "auth",
    "oauth2"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
